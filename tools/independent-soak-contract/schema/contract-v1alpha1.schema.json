{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ldb:distributed-state-soak-contract:v1alpha1",
  "title": "Distributed state soak contract — ineligible draft",
  "description": "Schema validation is not certification evidence. This alpha schema cannot represent an eligible contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "notice",
    "status",
    "certification_eligible",
    "scenario",
    "oracle",
    "gates"
  ],
  "properties": {
    "schema_version": {
      "const": "distributed-state-soak/v1alpha1"
    },
    "notice": {
      "const": "NOT CERTIFICATION EVIDENCE"
    },
    "status": {
      "const": "draft_ineligible"
    },
    "certification_eligible": {
      "const": false
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "admission",
        "delivery_guarantee",
        "source",
        "source_group_ordering",
        "operator",
        "output",
        "sink"
      ],
      "properties": {
