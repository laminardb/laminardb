        "source_group_ordering": {
          "const": "one_topic_partition_per_logical_group"
        },
        "operator": {
          "const": "grouped_count_star_sum_exact_integer_decimal"
        },
        "output": {
          "const": "append_result_snapshots"
        },
        "sink": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_capability", "implementation", "eligibility"],
          "properties": {
            "required_capability": {
              "const": "durable_multiwriter_append"
