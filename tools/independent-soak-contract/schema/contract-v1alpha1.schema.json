        "numerical_contract": {
          "$ref": "#/$defs/unresolved_gate"
        },
        "fault_controller": {
          "$ref": "#/$defs/unresolved_gate"
        },
        "evidence_store": {
          "$ref": "#/$defs/unresolved_gate"
        },
        "cluster_admission": {
          "$ref": "#/$defs/unresolved_gate"
        },
        "operation_identity": {
          "$ref": "#/$defs/unresolved_gate"
        },
        "assignment_provenance_and_fencing": {
          "$ref": "#/$defs/unresolved_gate"
        },
        "independent_dry_run": {
          "$ref": "#/$defs/unresolved_gate"
        }
