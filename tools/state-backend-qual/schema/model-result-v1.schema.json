{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laminardb.dev/schemas/state-backend-model-result-v1.json",
  "title": "LaminarDB state backend reference-model result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "notice",
    "qualification_eligible",
    "versions",
    "profile",
    "case",
    "counters",
    "digests"
  ],
  "properties": {
    "schema_version": {"const": "state-backend-model-result/v1"},
    "notice": {"const": "NOT QUALIFICATION EVIDENCE"},
    "qualification_eligible": {"const": false},
    "versions": {"$ref": "#/$defs/versions"},
    "profile": {"$ref": "#/$defs/profile"},
    "case": {"$ref": "#/$defs/modelCase"},
    "counters": {"$ref": "#/$defs/counters"},
    "digests": {"$ref": "#/$defs/digests"}
  },
  "$defs": {
    "uint32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "uint64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "generator",
        "request_encoding",
        "observation_encoding",
        "state_encoding"
      ],
      "properties": {
        "model": {"const": "state-backend-reference/v1"},
        "generator": {"const": "state-backend-workload/v1"},
        "request_encoding": {"const": "LDB-SBQ-REQUEST-V1"},
        "observation_encoding": {"const": "LDB-SBQ-OBSERVATION-V1"},
        "state_encoding": {"const": "LDB-SBQ-STATE-V1"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256", "model_input_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"},
        "model_input_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "modelCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario",
        "seed",
        "logical_state_bytes",
        "batch_rows",
        "request_count",
        "key_bytes",
        "value_bytes",
        "join_match_count"
      ],
      "properties": {
        "scenario": {"enum": ["aggregate", "timer_window", "join"]},
        "seed": {"$ref": "#/$defs/uint64"},
        "logical_state_bytes": {"$ref": "#/$defs/uint64"},
        "batch_rows": {"$ref": "#/$defs/uint32"},
        "request_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "key_bytes": {"$ref": "#/$defs/uint32"},
        "value_bytes": {"$ref": "#/$defs/uint32"},
        "join_match_count": {
          "oneOf": [
            {"$ref": "#/$defs/uint32"},
            {"type": "null"}
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "scenario": {"const": "join"},
            "join_match_count": {"$ref": "#/$defs/uint32"}
          }
        },
        {
          "properties": {
            "scenario": {"enum": ["aggregate", "timer_window"]},
            "join_match_count": {"type": "null"}
          }
        }
      ]
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "logical_input_rows",
        "point_reads",
        "range_reads",
        "puts",
        "deletes",
        "returned_point_values",
        "returned_point_bytes",
        "returned_range_rows",
        "returned_range_bytes"
      ],
      "properties": {
        "requests": {"$ref": "#/$defs/uint64"},
        "logical_input_rows": {"$ref": "#/$defs/uint64"},
        "point_reads": {"$ref": "#/$defs/uint64"},
        "range_reads": {"$ref": "#/$defs/uint64"},
        "puts": {"$ref": "#/$defs/uint64"},
        "deletes": {"$ref": "#/$defs/uint64"},
        "returned_point_values": {"$ref": "#/$defs/uint64"},
        "returned_point_bytes": {"$ref": "#/$defs/uint64"},
        "returned_range_rows": {"$ref": "#/$defs/uint64"},
        "returned_range_bytes": {"$ref": "#/$defs/uint64"}
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests_sha256",
        "observations_sha256",
        "trace_sha256",
        "live_state_sha256"
      ],
      "properties": {
        "requests_sha256": {"$ref": "#/$defs/digest"},
        "observations_sha256": {"$ref": "#/$defs/digest"},
        "trace_sha256": {"$ref": "#/$defs/digest"},
        "live_state_sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
