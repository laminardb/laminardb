{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laminardb.dev/schemas/state-backend-redb-prescreen-protected-review-policy-v1.json",
  "title": "LaminarDB redb prescreen protected-review policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "notice",
    "policy_id",
    "provider",
    "review_groups",
    "decision_literals",
    "required_controls",
    "protected_execution"
  ],
  "properties": {
    "schema_version": {
      "const": "state-backend-redb-prescreen-protected-review-policy/v1"
    },
    "notice": {"const": "NOT QUALIFICATION EVIDENCE"},
    "policy_id": {"$ref": "#/$defs/protocolId"},
    "provider": {"$ref": "#/$defs/provider"},
    "review_groups": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/reviewGroup"},
            {
              "properties": {"role": {"const": "workload_owner"}},
              "required": ["role"]
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/reviewGroup"},
            {
              "properties": {"role": {"const": "operations_owner"}},
              "required": ["role"]
            }
          ]
        }
      ],
      "items": false
    },
    "decision_literals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pre_run", "post_run"],
      "properties": {
        "pre_run": {"const": "APPROVE_REDB_PRESCREEN_EXECUTION_V1"},
        "post_run": {"const": "ACCEPT_REDB_PRESCREEN_RESULT_V1"}
      }
    },
    "required_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immutable_change_id",
        "reviews_on_exact_head",
        "current_group_membership",
        "approved_review_state",
        "dismiss_stale_reviews",
        "distinct_principals",
        "distinct_review_events",
        "self_review_allowed",
        "admin_bypass_allowed"
      ],
      "properties": {
        "immutable_change_id": {"const": true},
        "reviews_on_exact_head": {"const": true},
        "current_group_membership": {"const": true},
        "approved_review_state": {"const": true},
        "dismiss_stale_reviews": {"const": true},
        "distinct_principals": {"const": true},
        "distinct_review_events": {"const": true},
        "self_review_allowed": {"const": false},
        "admin_bypass_allowed": {"const": false}
      }
    },
    "protected_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_file", "job_name", "environment_id"],
      "properties": {
        "workflow_file": {
          "type": "string",
          "pattern": "^\\.github/workflows/[a-z0-9][a-z0-9._-]{0,127}\\.ya?ml$"
        },
        "job_name": {"$ref": "#/$defs/protocolId"},
        "environment_id": {"$ref": "#/$defs/providerId"}
      }
    }
  },
  "$defs": {
    "protocolId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._/-]{0,127}$"
    },
    "providerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:=/-]{0,255}$"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "repository_full_name", "repository_id", "base_ref"],
      "properties": {
        "contract": {"const": "github-protected-review-export/v1"},
        "repository_full_name": {"const": "laminardb/laminardb"},
        "repository_id": {"$ref": "#/$defs/providerId"},
        "base_ref": {"const": "refs/heads/main"}
      }
    },
    "reviewGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "group_id"],
      "properties": {
        "role": {"enum": ["workload_owner", "operations_owner"]},
        "group_id": {"$ref": "#/$defs/providerId"}
      }
    }
  }
}
