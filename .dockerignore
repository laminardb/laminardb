# Build artifacts (20-30GB+)
target/
**/target/

# Version control
.git/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# Documentation not needed in build
docs/
*.md
!README.md

# CI / config
.github/
.claude/

# Tests and benchmarks
tests/
benches/

# Deployment configs (not needed in image)
deploy/

# OS files
nul
Thumbs.db
.DS_Store

# Examples (only the standalone Markout Lab is needed by its image)
examples/*
!examples/demos/
examples/demos/*
!examples/demos/markout_lab/
!examples/demos/markout_lab/**
examples/demos/markout_lab/target/

# Logs
*.log
